rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function botPrice(id) {
      return id == 'pulse' ? 50 : id == 'quantum' ? 100 : id == 'neural' ? 200 : id == 'cyber' ? 300 : id == 'apex' ? 500 : 0;
    }
    function botTarget(id) { return botPrice(id) * 1.6; }
    function userBefore(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function userAfter(uid) { return getAfter(/databases/$(database)/documents/users/$(uid)).data; }
    function freshBotOrder(id) {
      return !exists(/databases/$(database)/documents/botPurchaseRequests/$(id))
        || get(/databases/$(database)/documents/botPurchaseRequests/$(id)).data.status == 'rejected';
    }
    function savedReferrer(profile) {
      return profile.get('purchaseReferrerUid', '') != '' ? profile.purchaseReferrerUid
        : profile.get('referredByUid', '') != '' ? profile.referredByUid : profile.get('referrerUid', '');
    }
    function validPurchaseReferrer(data) {
      return data.referrerUid is string && data.referrerCode is string && data.referrerName is string
        && (savedReferrer(userBefore(data.uid)) == '' || savedReferrer(userBefore(data.uid)) == data.referrerUid)
        && (data.referrerUid == '' ? data.referrerCode == '' && data.referrerName == ''
          : data.referrerUid != data.uid
            && get(/databases/$(database)/documents/publicLeaderboard/$(data.referrerUid)).data.collectorId == data.referrerCode
            && get(/databases/$(database)/documents/publicLeaderboard/$(data.referrerUid)).data.displayName == data.referrerName);
    }
    function walletBotOrder(id, data) {
      let before = userBefore(data.uid);
      let after = userAfter(data.uid);
      return data.paymentMethod == 'wallet' && data.status == 'approved'
        && data.senderNumber == '' && data.trxId == '' && data.receivingNumber == ''
        && data.reviewedBy == request.auth.uid && data.reviewedAt == request.time
        && before.balance is number && before.balance >= data.amount
        && after.balance == before.balance - data.amount
        && !(data.botId in before.get('unlockedBots', []))
        && after.unlockedBots == before.get('unlockedBots', []).concat([data.botId])
        && after.lastBotPurchaseId == id
        && after.purchaseReferrerUid == data.referrerUid && after.purchaseReferrerCode == data.referrerCode
        && getAfter(/databases/$(database)/documents/users/$(data.uid)/botMining/$(data.botId)).data.purchaseId == id
        && (data.referrerUid == '' || (
          userAfter(data.referrerUid).balance == userBefore(data.referrerUid).balance + data.amount / 20.0
          && userAfter(data.referrerUid).lastReferralRewardId == id));
    }
    function validBotOrder(id, data) {
      return data.keys().hasAll(['uid','userName','email','botId','botName','amount','paymentMethod','senderNumber','trxId','receivingNumber','status','createdAt','referrerUid','referrerCode','referrerName'])
        && data.keys().hasOnly(['uid','userName','email','botId','botName','amount','paymentMethod','senderNumber','trxId','receivingNumber','status','createdAt','referrerUid','referrerCode','referrerName','reviewedBy','reviewedAt'])
        && data.uid == request.auth.uid && id == data.uid + '_' + data.botId
        && botPrice(data.botId) > 0 && data.amount is int && data.amount == botPrice(data.botId)
        && data.userName is string && data.userName.size() <= 200 && data.email is string && data.botName is string
        && data.createdAt == request.time && validPurchaseReferrer(data)
        && (data.paymentMethod == 'wallet' ? walletBotOrder(id, data)
          : data.paymentMethod == 'bKash' && data.status == 'pending'
            && !data.keys().hasAny(['reviewedBy','reviewedAt'])
            && data.senderNumber.matches('^01[3-9][0-9]{8}$') && data.trxId.matches('^[A-Z0-9]{5,100}$')
            && get(/databases/$(database)/documents/appSettings/paymentSettings).data.active == true
            && data.receivingNumber == get(/databases/$(database)/documents/appSettings/paymentSettings).data.bkashNumber
            && getAfter(/databases/$(database)/documents/usedDepositTransactions/$(data.trxId)).data.source == 'bot'
            && getAfter(/databases/$(database)/documents/usedDepositTransactions/$(data.trxId)).data.depositId == id
            && getAfter(/databases/$(database)/documents/usedDepositTransactions/$(data.trxId)).data.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/usedDepositTransactions/$(data.trxId)).data.createdAt == request.time);
    }
    function ownWalletBotUpdate(uid) {
      let id = request.resource.data.lastBotPurchaseId;
      let order = getAfter(/databases/$(database)/documents/botPurchaseRequests/$(id)).data;
      return freshBotOrder(id) && order.createdAt == request.time && order.uid == uid
        && order.paymentMethod == 'wallet' && order.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance','unlockedBots','lastBotPurchaseId','purchaseReferrerUid','purchaseReferrerCode','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && walletBotOrder(id, order);
    }
    function referralCredit(uid) {
      let id = request.resource.data.lastReferralRewardId;
      let order = getAfter(/databases/$(database)/documents/botPurchaseRequests/$(id)).data;
      return order.uid == request.auth.uid && order.referrerUid == uid && uid != request.auth.uid
        && freshBotOrder(id) && order.createdAt == request.time && order.status == 'approved' && order.paymentMethod == 'wallet'
        && order.amount == botPrice(order.botId) && botPrice(order.botId) > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance','referralEarnings','lastReferralRewardId','updatedAt'])
        && resource.data.balance is number && request.resource.data.balance == resource.data.balance + order.amount / 20.0
        && request.resource.data.referralEarnings == resource.data.get('referralEarnings', 0) + order.amount / 20.0
        && request.resource.data.updatedAt == request.time
        && userAfter(order.uid).lastBotPurchaseId == id
        && userAfter(order.uid).balance == userBefore(order.uid).balance - order.amount;
    }

    // Public-to-signed-in payment configuration. The future Admin Panel should
    // edit appSettings/paymentSettings instead of hardcoding payment numbers.
    match /appSettings/{settingId} {
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && settingId == 'paymentSettings'
        && request.resource.data.keys().hasOnly(['bkashNumber', 'instructions', 'active', 'updatedAt', 'updatedBy'])
        && request.resource.data.bkashNumber is string
        && (request.resource.data.bkashNumber == '' || request.resource.data.bkashNumber.matches('^01[3-9][0-9]{8}$'))
        && request.resource.data.instructions is string
        && request.resource.data.instructions.size() <= 600
        && request.resource.data.active is bool
        && (!request.resource.data.active || request.resource.data.bkashNumber.matches('^01[3-9][0-9]{8}$'))
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Each numeric 8-digit Collector ID is reserved by a create-only document.
    // A reservation cannot be edited or deleted by users, preventing duplicate IDs.
    match /collectorIds/{collectorId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && collectorId.matches('^[0-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid', 'collectorId', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.collectorId == collectorId
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Public, minimal leaderboard records. Users may only publish their own
    // name and Collector ID; the bot count must match their real profile.
    match /publicLeaderboard/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && (request.auth.uid == uid || isAdmin())
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'collectorId', 'botCount', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.collectorId.matches('^[0-9]{8}$')
        && request.resource.data.collectorId == get(/databases/$(database)/documents/users/$(uid)).data.collectorId
        && request.resource.data.botCount is int
        && request.resource.data.botCount == (('unlockedBots' in get(/databases/$(database)/documents/users/$(uid)).data.keys()) ? get(/databases/$(database)/documents/users/$(uid)).data.unlockedBots.size() : 0)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','username','usernameLower','name','fullName','phoneNumber','email','role','balance','tasks','referrals','createdAt','updatedAt','collectorId','referralCode'])
        && request.resource.data.role == 'user'
        && request.resource.data.balance == 0
        && request.resource.data.tasks == 0
        && request.resource.data.referrals == 0
        && request.resource.data.collectorId.matches('^[0-9]{8}$')
        && request.resource.data.referralCode == request.resource.data.collectorId
        && getAfter(/databases/$(database)/documents/collectorIds/$(request.resource.data.collectorId)).data.uid == request.auth.uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'telegram', 'profileAvatar'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['profileAvatar']) || request.resource.data.profileAvatar in ['👨🏻‍💻', '👨🏽‍🚀', '🧑🏻‍🎤', '👩🏻‍💻', '👩🏽‍🚀', '👩🏻‍🎨', '🧑🏾‍🚀', '🦸🏻‍♂️']);
      // Daily Tap-to-Earn progress. Only the signed-in user can increment their
      // own count, one coin per write, up to 2,000 per Bangladesh-day key.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tapCoinsDate', 'tapCoinsCount', 'tapAdsUnlockedDate', 'tapCoinsUpdatedAt'])
        && request.resource.data.tapCoinsDate is string
        && request.resource.data.tapCoinsCount is int
        && request.resource.data.tapCoinsCount >= 1
        && request.resource.data.tapCoinsCount <= 2000
        && request.resource.data.tapCoinsUpdatedAt == request.time
        && (
          (resource.data.tapCoinsDate == request.resource.data.tapCoinsDate
            && resource.data.tapCoinsCount is int
            && resource.data.tapCoinsCount >= 0
            && resource.data.tapCoinsCount < 2000
            && request.resource.data.tapCoinsCount == resource.data.tapCoinsCount + 1)
          ||
          (resource.data.tapCoinsDate != request.resource.data.tapCoinsDate
            && request.resource.data.tapCoinsCount == 1)
          ||
          (!('tapCoinsDate' in resource.data.keys())
            && request.resource.data.tapCoinsCount == 1)
        )
        && (request.resource.data.tapCoinsCount == 2000
          ? request.resource.data.tapAdsUnlockedDate == request.resource.data.tapCoinsDate
          : request.resource.data.tapAdsUnlockedDate == null);
      // Existing accounts may receive an ID once, only when the matching reservation
      // is created in the same atomic Firestore batch.
      allow update: if signedIn() && request.auth.uid == uid
        && !('collectorId' in resource.data.keys())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collectorId', 'referralCode', 'updatedAt'])
        && request.resource.data.collectorId.matches('^[0-9]{8}$')
        && request.resource.data.referralCode == request.resource.data.collectorId
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/collectorIds/$(request.resource.data.collectorId)).data.uid == request.auth.uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unlockedBots', 'lastRedeemCode', 'updatedAt'])
        && request.resource.data.unlockedBots is list
        && request.resource.data.unlockedBots.size() == (('unlockedBots' in resource.data.keys()) ? resource.data.unlockedBots.size() + 1 : 1)
        && request.resource.data.unlockedBots.hasAll(('unlockedBots' in resource.data.keys()) ? resource.data.unlockedBots : [])
        && request.resource.data.lastRedeemCode is string
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/botRedeemCodes/$(request.resource.data.lastRedeemCode)).data.used == true
        && getAfter(/databases/$(database)/documents/botRedeemCodes/$(request.resource.data.lastRedeemCode)).data.usedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/botRedeemCodes/$(request.resource.data.lastRedeemCode)).data.usedAt == request.time
        && getAfter(/databases/$(database)/documents/botRedeemCodes/$(request.resource.data.lastRedeemCode)).data.botId in request.resource.data.unlockedBots
        && get(/databases/$(database)/documents/botRedeemCodes/$(request.resource.data.lastRedeemCode)).data.used == false
        && get(/databases/$(database)/documents/botRedeemCodes/$(request.resource.data.lastRedeemCode)).data.expiresAtMs > request.time.toMillis();
      allow update: if signedIn() && request.auth.uid == uid && ownWalletBotUpdate(uid);
      allow update: if signedIn() && request.auth.uid != uid && referralCredit(uid);
      allow update: if isAdmin();
      match /botMining/{botId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if isAdmin() || (signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['botId','botName','durationDays','targetReward','earnedReward','status','startedAt','purchaseId'])
          && request.resource.data.botId == botId && botPrice(botId) > 0
          && request.resource.data.durationDays == 30 && request.resource.data.targetReward == botTarget(botId)
          && request.resource.data.earnedReward == 0 && request.resource.data.status == 'running'
          && request.resource.data.startedAt == request.time
          && request.resource.data.purchaseId == uid + '_' + botId
          && freshBotOrder(request.resource.data.purchaseId)
          && getAfter(/databases/$(database)/documents/botPurchaseRequests/$(request.resource.data.purchaseId)).data.paymentMethod == 'wallet'
          && getAfter(/databases/$(database)/documents/botPurchaseRequests/$(request.resource.data.purchaseId)).data.status == 'approved'
          && getAfter(/databases/$(database)/documents/botPurchaseRequests/$(request.resource.data.purchaseId)).data.createdAt == request.time
          && userAfter(uid).lastBotPurchaseId == request.resource.data.purchaseId);
        allow update, delete: if false;
      }
    }

    match /tasks/{tid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /submissions/{sid} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && sid == request.auth.uid + '_' + request.resource.data.taskId
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid', 'email', 'taskId', 'taskTitle', 'reward', 'proof', 'image', 'status', 'createdAt'])
        && request.resource.data.proof is string && request.resource.data.proof.size() <= 300
        && request.resource.data.image is string && request.resource.data.image.size() <= 450000
        && (request.resource.data.proof.size() >= 3 || request.resource.data.image.size() >= 1000)
        && get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.active == true
        && request.resource.data.reward == get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.reward;
      allow update: if isAdmin();
    }

    match /wallets/{walletId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'number', 'createdAt'])
        && request.resource.data.type in ['bKash', 'Nagad', 'Rocket']
        && request.resource.data.number is string
        && request.resource.data.number.matches('^01[3-9][0-9]{8}$')
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount >= 100 && request.resource.data.amount <= 5000
        && request.resource.data.type in ['bKash', 'Nagad', 'Rocket']
        && request.resource.data.number is string
        && request.resource.data.number.matches('^01[3-9][0-9]{8}$')
        && request.resource.data.keys().hasOnly(['uid', 'amount', 'type', 'number', 'status', 'createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['paid', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    // Wallet deposit requests: user creates and reads only own requests; admin reviews.
    match /walletDeposits/{depositId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'userName', 'email', 'type', 'amount', 'senderNumber', 'trxId', 'status', 'createdAt', 'rejectionReason', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.type == 'bKash'
        && request.resource.data.amount is int
        && request.resource.data.amount >= 100 && request.resource.data.amount <= 50000
        && request.resource.data.senderNumber is string
        && request.resource.data.senderNumber.matches('^01[3-9][0-9]{8}$')
        && request.resource.data.trxId is string
        && request.resource.data.trxId.matches('^[A-Z0-9]{5,100}$')
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usedDepositTransactions/$(request.resource.data.trxId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/usedDepositTransactions/$(request.resource.data.trxId)).data.depositId == depositId
        && getAfter(/databases/$(database)/documents/usedDepositTransactions/$(request.resource.data.trxId)).data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usedDepositTransactions/$(request.resource.data.trxId)).data.get('source', 'deposit') == 'deposit';
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'rejectionReason'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (request.resource.data.status == 'approved'
          ? (!('rejectionReason' in request.resource.data.keys()) || request.resource.data.rejectionReason == '')
          : request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() >= 3
            && request.resource.data.rejectionReason.size() <= 300);
      allow delete: if false;
    }

    // One immutable TRX reservation shared by wallet deposits and direct bot payments.
    match /usedDepositTransactions/{trxId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','depositId','trxId','createdAt','source'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.depositId is string && request.resource.data.trxId == trxId
        && trxId.matches('^[A-Z0-9]{5,100}$') && request.resource.data.createdAt == request.time
        && (request.resource.data.get('source', 'deposit') == 'deposit'
          ? getAfter(/databases/$(database)/documents/walletDeposits/$(request.resource.data.depositId)).data.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/walletDeposits/$(request.resource.data.depositId)).data.trxId == trxId
          : request.resource.data.source == 'bot'
            && getAfter(/databases/$(database)/documents/botPurchaseRequests/$(request.resource.data.depositId)).data.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/botPurchaseRequests/$(request.resource.data.depositId)).data.trxId == trxId
            && getAfter(/databases/$(database)/documents/botPurchaseRequests/$(request.resource.data.depositId)).data.createdAt == request.time
            && getAfter(/databases/$(database)/documents/botPurchaseRequests/$(request.resource.data.depositId)).data.status == 'pending');
      allow update, delete: if false;
    }

    match /botPurchaseRequests/{requestId} {
      // Deterministic IDs allow a buyer to read an absent order before an atomic purchase.
      allow read: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid
        || requestId in [request.auth.uid + '_pulse',request.auth.uid + '_quantum',request.auth.uid + '_neural',request.auth.uid + '_cyber',request.auth.uid + '_apex']);
      allow create: if signedIn() && validBotOrder(requestId, request.resource.data);
      allow update: if (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'rejected'
        && request.resource.data.botId == resource.data.botId && validBotOrder(requestId, request.resource.data))
        || (isAdmin() && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt','rejectionReason'])
          && request.resource.data.status in ['approved','rejected']
          && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time
          && (request.resource.data.status == 'approved' || (request.resource.data.rejectionReason is string
            && request.resource.data.rejectionReason.size() >= 3 && request.resource.data.rejectionReason.size() <= 300)));
      allow delete: if false;
    }

    match /botRedeemCodes/{codeId} {
      allow read: if isAdmin() || (signedIn() && resource.data.used == false && resource.data.expiresAtMs > request.time.toMillis());
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['code', 'botId', 'botName', 'createdBy', 'createdAt', 'expiresAtMs', 'used', 'usedBy', 'usedAt'])
        && request.resource.data.code == codeId
        && request.resource.data.botId in ['pulse', 'quantum', 'neural', 'cyber', 'apex']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAtMs > request.time.toMillis()
        && request.resource.data.expiresAtMs <= request.time.toMillis() + 1800000
        && request.resource.data.used == false && request.resource.data.usedBy == null && request.resource.data.usedAt == null;
      allow update: if isAdmin() || (signedIn()
        && resource.data.used == false
        && resource.data.expiresAtMs > request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastRedeemCode == codeId
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.unlockedBots.hasAny([resource.data.botId]));
      allow delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}

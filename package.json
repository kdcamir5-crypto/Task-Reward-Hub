{
  "name": "task-reward-hub",
  "private": true,
  "scripts": {
    "test:purchases": "firebase emulators:exec --only firestore --project demo-trh-purchase \"node tests/purchases.cjs\"",
    "test:spin": "firebase emulators:exec --only firestore --project demo-trh-spin \"node tests/spin.cjs\"",
    "test:mining": "firebase emulators:exec --only firestore --project demo-trh-mining \"node --test tests/mining.test.cjs\"",
    "test:referrals": "firebase emulators:exec --only firestore --project demo-trh-referrals \"node --test tests/referrals.test.cjs\"",
    "test:withdrawals": "firebase emulators:exec --only firestore --project demo-trh-withdrawals \"node tests/withdrawals.cjs\"",
    "test:activity": "node --test tests/activity.test.cjs",
    "test:notifications": "node --test tests/notifications.test.cjs",
    "test:notifications:rules": "firebase emulators:exec --only firestore --project demo-trh-notifications \"node tests/notifications-rules.cjs\"",
    "test:codes": "firebase emulators:exec --only firestore --project demo-trh-codes \"node tests/reward-codes.cjs\"",
    "test:community": "firebase emulators:exec --only firestore --project demo-trh-community \"node tests/community.cjs\"",
    "test:telegram": "node --test tests/telegram-auth.test.mjs tests/telegram-client.test.cjs",
    "test:telegram:identities": "firebase emulators:exec --only firestore --project demo-trh-telegram \"node --test tests/telegram-identities.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "14.27.0",
    "firebase-admin": "13.6.0"
  }
}
